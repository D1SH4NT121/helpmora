# Required — NVIDIA NIM key used by byllm for the model chain in llm/stubs.jac
# (default primary: mistralai/mistral-nemotron).
# Get a free key at https://build.nvidia.com/.
NVIDIA_NIM_API_KEY=

# Optional — fallback provider used if NIM is unreachable. Leave blank to disable.
FEATHERLESS_API_KEY=

# Optional — Groq key; when set, groq/openai/gpt-oss-20b leads the model pool.
# GROQ_API_KEY=

# Optional — pin the date used by effective-dated eligibility rules (YYYY-MM-DD).
# HELPMORA_POLICY_DATE=2026-09-27

# Optional — override the LLM fallback chain (comma-separated litellm ids, tried in order).
# HELPMORA_LLM_MODELS=nvidia_nim/openai/gpt-oss-20b,nvidia_nim/google/gemma-4-31b-it

# Optional — lead models for long-tail languages (summaries). Default: Gemma 4 on NIM.
# HELPMORA_POLYGLOT_MODELS=nvidia_nim/google/gemma-4-31b-it

# ========================================================
# HACKATHON INTEGRATIONS: OMI + QDRANT + LYZR
# ========================================================

# Omi Voice Integration
# Optional webhook secret or signature token for incoming Omi voice events
OMI_WEBHOOK_SECRET=
OMI_API_KEY=
# Public base URL for webhook callbacks (e.g., https://your-domain.ngrok-free.app or production domain)
PUBLIC_BASE_URL=

# Qdrant Persistent Semantic Memory
# Remote cluster URL (leave blank to automatically use local embedded storage)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=helpmora_memory
QDRANT_STORAGE_PATH=./data/qdrant_db

# Lyzr Agent Orchestration
# Leave blank to run local deterministic multi-agent orchestration
LYZR_API_KEY=
LYZR_ENVIRONMENT_ID=
LYZR_MANAGER_AGENT_ID=
